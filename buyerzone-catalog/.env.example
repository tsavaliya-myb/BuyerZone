# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_SESSION_NAME=buyerzone

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
DB_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://buyerzone:changeme@postgres:5432/buyerzone

# ── Qdrant ─────────────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=product_embeddings
QDRANT_URL=https://your-cluster-id.aws.cloud.qdrant.io   # cloud: overrides host+port
QDRANT_API_KEY=your_qdrant_api_key

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# ── S3-compatible Storage (Cloudflare R2) ──────────────────────────────────────
S3_ACCESS_KEY_ID=your_key
S3_SECRET_ACCESS_KEY=your_secret
S3_BUCKET_NAME=buyerzone-products
S3_PUBLIC_URL=https://your-r2-domain.com
S3_ENDPOINT_URL=https://your_account_id.r2.cloudflarestorage.com
S3_REGION=auto

# ── Security ───────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change_this_to_a_256_bit_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
INTERNAL_API_KEY=change_this_internal_service_token

# ── Ingestion internal server ──────────────────────────────────────────────────
INGESTION_INTERNAL_PORT=8001
INGESTION_INTERNAL_URL=http://ingestion:8001

# ── App ────────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
DEDUP_SIMILARITY_THRESHOLD=0.96
STALENESS_DAYS=30
